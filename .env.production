NEXT_PUBLIC_API_URL=https://d6mvnylha0j3u.cloudfront.net/api

# Storefront origin (e.g. https://www.cleanseayurveda.com). Used for canonical
# og:url in blog share previews. Set this to the real production domain. Leave
# blank to omit og:url — title, description and og:image still work.
NEXT_PUBLIC_SITE_URL=

# MSG91 OTP widget (client-side creds — public by design)
NEXT_PUBLIC_MSG91_WIDGET_ID=36667a6b4658393733363338
NEXT_PUBLIC_MSG91_TOKEN_AUTH=513192T4igXCLQ6a3e63abP1

# ── Maintenance mode ──
# Server-only, deliberately NOT NEXT_PUBLIC_: those are inlined into the client
# bundle at build time, which would publish the bypass token to every visitor.
# Do NOT set this to an empty value. @next/env loads .env.production BEFORE .env
# and never overwrites a key that is already set, so a bare
# `MAINTENANCE_BYPASS_TOKEN=` here wins over the real token in the server's
# untracked .env and silently disables the bypass (proxy.js and the layout gate
# both read an empty token as "no bypass"). Either give it a real value or leave
# the line commented out entirely.
MAINTENANCE_BYPASS_TOKEN=xyz_strongpass_noone_can_think
# Emergency switch for when the API is unreachable (the flag fetch fails open).
MAINTENANCE_FORCE=
# MAINTENANCE_TTL_MS=5000
# Optional internal origin for the server-side flag fetch. Falls back to
# NEXT_PUBLIC_API_URL. Runtime-read, so it can point somewhere the CDN cannot.
API_URL=


NEXT_PUBLIC_GOOGLE_CLIENT_ID=1003374343714-glbe3bo2lpcjc97jmifonv9matt0cm6o.apps.googleusercontent.com
