# ── Maintenance mode (all server-only — NOT NEXT_PUBLIC_, which is build-inlined) ──
# Set to 1 to force the maintenance screen without touching the DB. Also the way to
# take the site down when the API itself is unreachable, since the flag fetch fails
# open by design.
MAINTENANCE_FORCE=
# Staff bypass: visit /?preview=<this> to view the real site while maintenance is on.
MAINTENANCE_BYPASS_TOKEN=dev-bypass
# How long the flag is memoised in the server process. Worst-case toggle latency.
MAINTENANCE_TTL_MS=5000

NEXT_PUBLIC_API_URL=https://d6mvnylha0j3u.cloudfront.net/api

# Storefront origin (e.g. https://www.cleanseayurveda.com). Used for canonical
# og:url in blog share previews. Set this to the real production domain. Leave
# blank to omit og:url — title, description and og:image still work.
NEXT_PUBLIC_SITE_URL=

